# Dify Cloud: https://api.dify.ai/v1. Self-hosted: use your API URL including /v1.
DIFY_BASE_URL=https://api.dify.ai/v1

# Chat/Chatflow, Workflow, and Agent app API keys. Each key is app-scoped.
DIFY_CHAT_API_KEY=app-your-chat-or-chatflow-key
DIFY_WORKFLOW_API_KEY=app-your-workflow-key
DIFY_AGENT_API_KEY=app-your-agent-key

# Classic Knowledge Base Service API settings (not an app key).
DIFY_KNOWLEDGE_BASE_URL=https://api.dify.ai/v1
DIFY_KNOWLEDGE_API_KEY=dataset-service-key
DIFY_DATASET_ID=your-classic-knowledge-base-id

# Use a stable user ID consistently across a conversation and its uploaded files.
DIFY_USER=demo-user

# Synthetic local business API used by the OpenAPI tool demo.
DEMO_BUSINESS_API_TOKEN=replace-with-a-long-random-demo-token
BUSINESS_API_HOST=0.0.0.0
BUSINESS_API_PORT=8088
